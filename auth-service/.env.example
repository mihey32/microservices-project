# ─── JWT ───────────────────────────────────────────────────────────
# HS256 secret: base64, ≥ 32 байта после декодирования.
# Генерация:
#   Linux/Mac:   openssl rand -base64 32
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Max 256}))
#   Git Bash:    openssl rand -base64 32
JWT_SECRET=CHANGE_ME_BASE64_32_BYTES

# ─── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=auth-service-db

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/auth-service-db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# ─── Kafka / Redis ─────────────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_DATA_REDIS_HOST=redis

# ─── OAuth2 (опционально) ──────────────────────────────────────────
# Без этих переменных OAuth-логины не работают, но сервис стартует.
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=not-configured
GOOGLE_OAUTH_CLIENT_SECRET=not-configured

# GitHub: https://github.com/settings/developers → OAuth Apps
GITHUB_OAUTH_CLIENT_ID=not-configured
GITHUB_OAUTH_CLIENT_SECRET=not-configured

# ─── Mailhog ────────────────────────────────
SPRING_MAIL_HOST=mailhog

# email для bootstrap первого админа (повышается до ROLE_ADMIN при старте).
# Аккаунт должен быть уже зарегистрирован. Оставьте пустым, если не нужно.
BOOTSTRAP_ADMIN_EMAIL=